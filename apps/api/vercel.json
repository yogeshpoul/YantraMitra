{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && NODE_ENV=development pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm build:packages && pnpm --filter @yantramitra/api build:serverless",
  "outputDirectory": "public",
  "regions": ["bom1"],
  "functions": {
    "api/index.js": { "maxDuration": 30, "memory": 1024, "includeFiles": "dist/**" }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
