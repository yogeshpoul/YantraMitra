{
  "name": "@yantramitra/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx src/cli/seed.ts",
    "db:seed:dev": "tsx src/cli/seed-dev.ts",
    "places:import": "tsx src/cli/import-places.ts",
    "admin": "tsx src/cli/admin.ts",
    "start:prod": "node dist/main.js",
    "migrate:prod": "prisma migrate deploy",
    "build:serverless": "pnpm build && node scripts/bundle-serverless.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.2",
    "@nestjs/core": "^12.6.2",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.6.2",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.8.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/node": "^11.18.0",
    "@yantramitra/shared-types": "workspace:*",
    "@yantramitra/shared-validation": "workspace:*",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "fflate": "^0.8.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-dist": "5.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/testing": "^12.6.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "@yantramitra/config": "workspace:*",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.2",
    "tsx": "^4.20.6"
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ]
}
