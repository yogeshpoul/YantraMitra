# Copy to apps/api/.env. Never commit the copy.
NODE_ENV=development
PORT=4000

# Docker compose: postgresql://yantramitra:yantramitra@localhost:5433/yantramitra
# scripts/devdb.ps1: postgresql://yantramitra@127.0.0.1:55432/yantramitra
DATABASE_URL=postgresql://yantramitra:yantramitra@localhost:5433/yantramitra

# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000
# Set to the number of trusted reverse proxies in front of the API (0 = none)
TRUST_PROXY_HOPS=1
# Shared with the website server so server-side rendering is not rate limited. Optional in development.
INTERNAL_API_KEY=

# Limits
RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=15
CONTACT_REVEALS_PER_DAY=50
DEFAULT_SEARCH_RADIUS_KM=25

# Location search: local (free, offline gazetteer) | nominatim | google
LOCATION_PROVIDER=local
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=
GOOGLE_MAPS_SERVER_KEY=

# Optional
SENTRY_DSN=
SWAGGER_ENABLED=true

# Used only by `pnpm --filter @yantramitra/api admin create`
ADMIN_MOBILE=
ADMIN_NAME=
ADMIN_PASSWORD=
