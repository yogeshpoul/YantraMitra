# Copy to apps/web/.env.local
# Where the Next.js server reaches the API (server-side rendering and the /api proxy)
API_INTERNAL_URL=http://localhost:4000
# Same value as the API's INTERNAL_API_KEY. Exempts server-side rendering from IP rate limits.
INTERNAL_API_KEY=
# Canonical public origin, used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Map tiles. OpenStreetMap's public tiles are fine for development and small pilots (see their usage policy).
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
# Optional: enables Google Maps for the location picker instead of OpenStreetMap
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Optional: support contact shown on the forgot-password screen (E.164)
NEXT_PUBLIC_SUPPORT_PHONE=
