# Android emulator reaches the host machine at 10.0.2.2. On a phone, use your computer's LAN IP or the production URL.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1
# Optional: tiles for the map pin picker (OpenStreetMap by default)
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
