{
  "name": "@yantramitra/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:web": "expo export --platform web --output-dir dist-web",
    "typecheck": "tsc --noEmit",
    "test": "echo \"mobile logic is covered by shared package tests\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@yantramitra/api-client": "workspace:*",
    "@yantramitra/i18n": "workspace:*",
    "@yantramitra/illustrations": "workspace:*",
    "@yantramitra/shared-types": "workspace:*",
    "@yantramitra/shared-validation": "workspace:*",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.22",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "use-intl": "^4.15.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@yantramitra/config": "workspace:*",
    "typescript": "~6.0.3"
  }
}
